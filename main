let activeSemester = 'a';

// ── PROGRESS (localStorage) ──────────────────────────────────────────────────
const STORAGE_KEY = 'osim-progress-yearB';
let progress = { courses: {}, topics: {} };

function loadProgress() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if(raw) progress = Object.assign({ courses: {}, topics: {} }, JSON.parse(raw));
  } catch(e) { /* דפדפן חוסם אחסון — האתר ימשיך לעבוד בלי שמירה */ }
}

function saveProgress() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(progress)); }
  catch(e) { /* שקט — לא מפיל את האתר */ }
}

function semesterComplete(key) {
  const list = SEMESTERS[key].courses;
  return list.length > 0 && list.every(c => progress.courses[c.id]);
}

function toggleCourseDone(id, ev) {
  if(ev) ev.stopPropagation();
  const wasComplete = semesterComplete(activeSemester);
  progress.courses[id] = !progress.courses[id];
  saveProgress();
  render();
  // חוגגים רק ברגע המעבר מ"לא הכל" ל"הכל" — לא בכל טעינת עמוד
  if(!wasComplete && semesterComplete(activeSemester)) {
    celebrate(SEMESTERS[activeSemester].label);
  }
}

function toggleTopicDone(courseId, idx, ev) {
  if(ev) ev.stopPropagation();
  const key = courseId + '::' + idx;
  progress.topics[key] = !progress.topics[key];
  saveProgress();
  render();
}

function resetProgress() {
  if(!confirm('לאפס את כל סימוני ההתקדמות?')) return;
  progress = { courses: {}, topics: {} };
  saveProgress();
  render();
}

// ── HELPERS ──────────────────────────────────────────────────────────────────
function daysLeft(dateStr) { return Math.ceil((new Date(dateStr) - new Date()) / 86400000); }
function formatDate(dateStr) {
  return new Date(dateStr).toLocaleDateString('he-IL', { day: 'numeric', month: 'numeric' });
}

// תאריך + שעה לכרטיס, למשל "17.1.2027 · 13:00"
function formatExam(dateStr) {
  const d = new Date(dateStr);
  const date = d.toLocaleDateString('he-IL', { day: 'numeric', month: 'numeric', year: 'numeric' });
  const time = d.toLocaleTimeString('he-IL', { hour: '2-digit', minute: '2-digit' });
  return `${date} · ${time}`;
}
function allCourses() {
  return [...SEMESTERS.a.courses, ...SEMESTERS.b.courses];
}

// ── HERO COUNTDOWN ───────────────────────────────────────────────────────────
function updateHeroCountdown() {
  const el = document.getElementById('heroCountdown');
  const next = allCourses().filter(c => c.examDate)
    .map(c => ({ name: c.name, ms: new Date(c.examDate) - new Date() }))
    .filter(c => c.ms > 0)
    .sort((a,b) => a.ms - b.ms)[0];

  if(!next) {
    el.innerHTML = `
      <div class="good-luck-msg">
        <span class="gl-emoji">🌱</span>
        <span class="gl-text">שנה ב׳ מתחילה — בהצלחה!</span>
        <span class="gl-emoji">🌱</span>
      </div>`;
    return;
  }

  const s = Math.floor(next.ms / 1000);
  const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
  el.innerHTML = `
    <div class="next-name">⏰ המבחן הבא: ${next.name}</div>
    <div class="countdown-boxes">
      <div class="countdown-box"><span class="box-num">${d}</span><span class="box-label">ימים</span></div>
      <div class="countdown-box"><span class="box-num">${String(h).padStart(2,'0')}</span><span class="box-label">שעות</span></div>
      <div class="countdown-box"><span class="box-num">${String(m).padStart(2,'0')}</span><span class="box-label">דקות</span></div>
    </div>`;
}

// ── TABS ─────────────────────────────────────────────────────────────────────
function buildTabs() {
  document.getElementById('tabsBar').innerHTML = Object.keys(SEMESTERS).map(key => {
    const s = SEMESTERS[key];
    const done = s.courses.filter(c => progress.courses[c.id]).length;
    return `<button class="tab-btn ${key === activeSemester ? 'active' : ''}" onclick="setSemester('${key}')">
      ${s.label}
      <span class="tab-count">${done}/${s.courses.length}</span>
    </button>`;
  }).join('');
}

function setSemester(key) {
  activeSemester = key;
  buildTabs();
  render();
  window.scrollTo({ top: document.querySelector('main').offsetTop - 120, behavior: 'smooth' });
}

// ── RENDER ───────────────────────────────────────────────────────────────────
function render() {
  const grid = document.getElementById('coursesGrid');
  const courses = SEMESTERS[activeSemester].courses;
  grid.innerHTML = '';

  if(courses.length === 0) {
    grid.innerHTML = `
      <div class="empty-state">
        <div class="big">🌱</div>
        <p>קורסי ${SEMESTERS[activeSemester].label} עוד לא פורסמו</p>
      </div>`;
    updateStats();
    buildTabs();
    return;
  }

  courses.forEach((course, ci) => {
    const isDone = !!progress.courses[course.id];
    const links = course.links || {};
    const linksCount = [links.syllabus, links.summary, links.notebook, links.past].filter(Boolean).length;
    const linkPct = Math.round(linksCount / 4 * 100);

    const card = document.createElement('div');
    card.className = 'course-card' + (isDone ? ' done' : '');
    card.style.animationDelay = `${ci * 0.04}s`;

    card.innerHTML = `
      <div class="progress-bar-wrap">
        <div class="progress-bar-fill" style="width:${linkPct}%"></div>
      </div>
      <div class="course-header" onclick="toggleTopics('${course.id}')">
        <div class="course-left">
          <div class="course-icon" style="background:${course.color}22; color:${course.color}">${course.emoji}</div>
          <div>
            <div class="course-title">${course.name}</div>
            <div class="course-meta">${course.examDate ? '📅 ' + formatExam(course.examDate) : ''}</div>
            ${course.examNote ? `<div class="course-note">${course.examNote}</div>` : ''}
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <button class="done-toggle ${isDone ? 'on' : ''}" onclick="toggleCourseDone('${course.id}', event)">
            <span class="check">${isDone ? '✓' : '○'}</span> ${isDone ? 'סיימתי' : 'סמן'}
          </button>
          <span class="chevron" id="chev-${course.id}">▾</span>
        </div>
      </div>
      <div class="topics-wrap" id="topics-${course.id}">
        ${course.topics.length > 0 ? `
          <div style="padding: 0 0 0.8rem;">
            ${course.topics.map((t, ti) => {
              const tDone = !!progress.topics[course.id + '::' + ti];
              return `
              <div class="topic-item ${tDone ? 'done' : ''}">
                <div class="topic-row" onclick="toggleTopicDone('${course.id}', ${ti}, event)">
                  <span class="topic-box">✓</span>
                  <span class="topic-name">${t}</span>
                </div>
              </div>`;
            }).join('')}
          </div>
        ` : ''}
        <div class="links-bar">
          ${links.syllabus ? `<a class="link-btn syllabus" href="${links.syllabus}" target="_blank" rel="noopener">📄 סילבוס</a>`              : `<span class="link-btn syllabus empty">📄 סילבוס</span>`}
          ${links.summary  ? `<a class="link-btn summary"  href="${links.summary}"  target="_blank" rel="noopener">📝 מחברת בחינה</a>`       : `<span class="link-btn summary empty">📝 מחברת בחינה</span>`}
          ${links.notebook ? `<a class="link-btn notebook" href="${links.notebook}" target="_blank" rel="noopener">🎙️ פודקאסטים וסרטונים</a>` : `<span class="link-btn notebook empty">🎙️ פודקאסטים וסרטונים</span>`}
          ${links.past     ? `<a class="link-btn past"     href="${links.past}"     target="_blank" rel="noopener">🗂️ מבחנים קודמים</a>`      : `<span class="link-btn past empty">🗂️ מבחנים קודמים</span>`}
        </div>
      </div>
    `;
    grid.appendChild(card);
  });

  updateStats();
  buildTabs();
}

function updateStats() {
  const courses = SEMESTERS[activeSemester].courses;
  const doneCount = courses.filter(c => progress.courses[c.id]).length;
  const pct = courses.length ? Math.round(doneCount / courses.length * 100) : 0;

  const nextExam = allCourses().filter(c => c.examDate)
    .map(c => ({ name: c.name, days: daysLeft(c.examDate) }))
    .filter(c => c.days >= 0).sort((a,b) => a.days - b.days)[0];

  document.getElementById('statsBar').innerHTML = `
    <div class="stat-pill"><strong>${courses.length}</strong> קורסים · ${SEMESTERS[activeSemester].label}</div>
    <div class="stat-pill progress-pill">
      <span>סיימתי <strong>${doneCount}/${courses.length}</strong></span>
      <span class="mini-bar"><span class="mini-bar-fill" style="width:${pct}%"></span></span>
    </div>
    ${nextExam ? `<div class="stat-pill">⏰ המבחן הכי קרוב: <strong>${nextExam.name}</strong> — עוד ${nextExam.days} ימים</div>` : ''}
    ${doneCount > 0 ? `<button class="btn-reset" onclick="resetProgress()">איפוס סימונים</button>` : ''}
  `;
}

function toggleTopics(id) {
  document.getElementById('topics-' + id).classList.toggle('open');
  document.getElementById('chev-' + id).classList.toggle('open');
}

// ── GRADE CALCULATOR (per-course) ────────────────────────────────────────────
let tasks = [
  { label: 'מטלת ביניים', weight: 15, grade: '' },
  { label: 'מבחן מסכם',   weight: 85, grade: '', isFinal: true },
];

function renderCalcRows() {
  const container = document.getElementById('calcRows');
  container.innerHTML = '';
  tasks.forEach((task, i) => {
    const row = document.createElement('div');
    row.style.cssText = 'display:flex;align-items:center;gap:0.7rem;margin-bottom:0.8rem;';
    row.innerHTML = `
      <input type="text" value="${task.label}" placeholder="שם מטלה"
        style="flex:1;background:var(--surface2);border:1.5px solid var(--border);border-radius:8px;padding:0.45rem 0.7rem;font-family:'Assistant',sans-serif;font-size:0.88rem;color:var(--text);outline:none;direction:rtl;"
        oninput="tasks[${i}].label=this.value">
      <div style="display:flex;align-items:center;gap:0.3rem;">
        <input type="number" value="${task.weight}" min="1" max="100" placeholder="%"
          style="width:58px;background:var(--surface2);border:1.5px solid var(--border);border-radius:8px;padding:0.45rem 0.5rem;text-align:center;font-family:'Assistant',sans-serif;font-size:0.88rem;color:var(--text);outline:none;"
          oninput="tasks[${i}].weight=parseFloat(this.value)||0;calcGrade()">
        <span style="font-size:0.8rem;color:var(--muted);">%</span>
      </div>
      <input type="number" value="${task.grade}" min="0" max="100" placeholder="ציון"
        style="width:68px;background:var(--surface2);border:1.5px solid var(--border);border-radius:8px;padding:0.45rem 0.5rem;text-align:center;font-family:'Assistant',sans-serif;font-size:0.9rem;color:var(--text);outline:none;"
        oninput="tasks[${i}].grade=this.value;calcGrade()">
      ${tasks.length > 2 && !task.isFinal ? `<button class="btn-remove-task" onclick="removeTask(${i})">✕</button>` : '<span style="width:20px"></span>'}
    `;
    container.appendChild(row);
  });
  calcGrade();
}

function addTask() {
  const finalIdx = tasks.findIndex(t => t.isFinal);
  tasks.splice(finalIdx, 0, { label: 'מטלת ביניים', weight: 0, grade: '' });
  renderCalcRows();
}
function removeTask(i) { tasks.splice(i, 1); renderCalcRows(); }

function calcGrade() {
  const totalWeight = tasks.reduce((s, t) => s + (parseFloat(t.weight) || 0), 0);
  const statusEl = document.getElementById('weightStatus');

  if(Math.round(totalWeight) !== 100) {
    statusEl.textContent = `סכום האחוזים: ${totalWeight}% — חייב להיות בדיוק 100%`;
    statusEl.className = 'weight-status weight-bad';
    document.getElementById('calcResult').textContent = '—';
    document.getElementById('calcSub').textContent = 'תקן את האחוזים';
    return;
  }

  statusEl.textContent = '✓ סכום האחוזים: 100%';
  statusEl.className = 'weight-status weight-ok';

  let total = 0, weightUsed = 0;
  tasks.forEach(t => {
    const g = parseFloat(t.grade), w = parseFloat(t.weight) || 0;
    if(!isNaN(g)) { total += g * (w / 100); weightUsed += w / 100; }
  });

  if(weightUsed === 0) {
    document.getElementById('calcResult').textContent = '—';
    document.getElementById('calcSub').textContent = 'מלא את הציונים למעלה';
    return;
  }

  const grade = Math.round((total / weightUsed) * 10) / 10;
  document.getElementById('calcResult').textContent = grade.toFixed(1);
  document.getElementById('calcSub').textContent =
    grade >= 90 ? 'מצוין! 🌟' : grade >= 80 ? 'טוב מאוד 👏' : grade >= 70 ? 'טוב 👍' : grade >= 60 ? 'עובר ✓' : 'לא עובר ✗';
}

function openCalc() { renderCalcRows(); document.getElementById('calcModal').classList.add('show'); }
function closeCalc() { document.getElementById('calcModal').classList.remove('show'); }
function closeCalcIfBg(e) { if(e.target.id === 'calcModal') closeCalc(); }
document.addEventListener('keydown', e => { if(e.key === 'Escape') closeCalc(); });

// ═══════════════════════════════════════════════════════════════════════════
//  מחשבון ממוצע משוקלל — שנה א׳ + שנה ב׳
//  נ"ז: ערכי ברירת מחדל — עדכן לפי הסילבוסים / השנתון
// ═══════════════════════════════════════════════════════════════════════════
