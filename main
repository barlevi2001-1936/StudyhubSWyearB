        <button class="gpa-gtab"        data-scope="yearA" onclick="setGpaScope('yearA')">שנה א׳ בלבד</button>
        <button class="gpa-gtab"        data-scope="yearB" onclick="setGpaScope('yearB')">שנה ב׳ בלבד</button>
      </div>

      <div class="gpa-table-wrap">
