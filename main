  { name: 'התפתחות האדם במשפחה א׳', credits: 2 },
  { name: 'התפתחות האדם במשפחה חלק ב׳', credits: 2 },
  { name: 'תיאוריות אישיות: מושגי יסוד', credits: 2 },
  { name: 'ההיבט הפרטני בעבודה סוציאלית', credits: 2 },
  { name: 'ההיבט הקהילתי בעבודה סוציאלית', credits: 2 },
  { name: 'ארגון וניהול של שרותי רווחה', credits: 2 },
  { name: 'כלכלת הרווחה - מושגי יסוד', credits: 2 },
