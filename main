let gpaScope = 'all';
let gpaData = {
  yearA: YEAR_A_COURSES.map(c => ({ name: c.name, grade: '', credits: c.credits })),
  yearB: allCourses().map(c => ({ name: c.name, grade: '', credits: c.credits || 2 })),
};

function toggleGpa() {
  const body = document.getElementById('gpaBody');
  const chev = document.getElementById('gpaChevron');
  body.classList.toggle('open');
  chev.classList.toggle('open');
  if(body.classList.contains('open')) renderGpaRows();
}

function jumpToGpa() {
  const body = document.getElementById('gpaBody');
  if(!body.classList.contains('open')) toggleGpa();
  document.getElementById('gpaSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function setGpaScope(scope) {
  gpaScope = scope;
  document.querySelectorAll('.gpa-gtab').forEach(b => {
    b.classList.toggle('active', b.dataset.scope === scope);
  });
  document.getElementById('gpaResult').classList.remove('show');
  renderGpaRows();
}

function renderGpaRows() {
  const tbody = document.getElementById('gpaRows');
  tbody.innerHTML = '';

  const sections = gpaScope === 'all'
    ? [['yearA', 'שנה א׳'], ['yearB', 'שנה ב׳']]
    : gpaScope === 'yearA' ? [['yearA', 'שנה א׳']] : [['yearB', 'שנה ב׳']];

  sections.forEach(([key, label]) => {
    if(gpaScope === 'all') {
      const hdr = document.createElement('tr');
      hdr.className = 'gpa-year-row';
      hdr.innerHTML = `<td colspan="4">${label}</td>`;
      tbody.appendChild(hdr);
    }
    gpaData[key].forEach((row, i) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="gpa-course-name">${row.name}</td>
        <td><input class="gpa-input" type="number" min="0" max="100" placeholder="ציון" value="${row.grade}"
              oninput="gpaData['${key}'][${i}].grade=this.value"></td>
        <td><input class="gpa-input" type="number" min="1" max="12" placeholder='נ"ז' value="${row.credits}"
              oninput="gpaData['${key}'][${i}].credits=parseFloat(this.value)||0"></td>
        <td><button class="gpa-btn-remove" onclick="removeGpaRow('${key}', ${i})">✕</button></td>
      `;
      tbody.appendChild(tr);
    });
  });
}

function addGpaRow() {
  const key = gpaScope === 'yearA' ? 'yearA' : 'yearB';
  gpaData[key].push({ name: 'קורס חדש', grade: '', credits: 2 });
  renderGpaRows();
}

function removeGpaRow(key, i) {
  gpaData[key].splice(i, 1);
  renderGpaRows();
  document.getElementById('gpaResult').classList.remove('show');
}

function calcGPA() {
  const keys = gpaScope === 'all' ? ['yearA', 'yearB'] : [gpaScope];
  let totalPoints = 0, totalCredits = 0, counted = 0;

  keys.forEach(key => {
    gpaData[key].forEach(r => {
      const g = parseFloat(r.grade), c = parseFloat(r.credits) || 0;
      if(!isNaN(g) && c > 0) { totalPoints += g * c; totalCredits += c; counted++; }
    });
  });

  const result = document.getElementById('gpaResult');
  if(totalCredits === 0) { result.classList.remove('show'); return; }

  document.getElementById('gpaResultVal').textContent = (totalPoints / totalCredits).toFixed(2);
  document.getElementById('gpaResultSub').textContent =
    `מבוסס על ${counted} קורסים · ${totalCredits} נ"ז`;
  result.classList.add('show');
}

// ═══════════════════════════════════════════════════════════════════════════
//  🎆 זיקוקים — נורים כשמסמנים את כל הקורסים בסמסטר
// ═══════════════════════════════════════════════════════════════════════════
const fxCanvas = document.getElementById('fxCanvas');
const fxCtx = fxCanvas.getContext('2d');
let fxParticles = [], fxRunning = false, fxEndAt = 0, fxNextBurst = 0;
const FX_COLORS = ['#2d6a4f', '#52b788', '#f4a261', '#e9c46a', '#e05260', '#b7e4c7', '#457b9d'];

function fxResize() {
  fxCanvas.width  = window.innerWidth;
  fxCanvas.height = window.innerHeight;
}
window.addEventListener('resize', fxResize);

function fxBurst(x, y) {
  const color = FX_COLORS[Math.floor(Math.random() * FX_COLORS.length)];
  const count = 46 + Math.floor(Math.random() * 22);
  for(let i = 0; i < count; i++) {
    const angle = (Math.PI * 2 * i) / count + Math.random() * 0.25;
    const speed = 2.2 + Math.random() * 4.2;
    fxParticles.push({
      x, y,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed,
      life: 1,
      decay: 0.008 + Math.random() * 0.012,
      size: 1.8 + Math.random() * 2.4,
      color: Math.random() < 0.22 ? '#ffffff' : color,
    });
  }
}

function fxLoop(now) {
  if(!fxRunning) return;
  fxCtx.clearRect(0, 0, fxCanvas.width, fxCanvas.height);

  // פיצוץ חדש כל ~450ms כל עוד החגיגה נמשכת
  if(now < fxEndAt && now > fxNextBurst) {
    fxBurst(
      fxCanvas.width  * (0.15 + Math.random() * 0.7),
      fxCanvas.height * (0.15 + Math.random() * 0.45)
    );
    fxNextBurst = now + 320 + Math.random() * 320;
  }

  fxParticles = fxParticles.filter(p => p.life > 0);
  fxParticles.forEach(p => {
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.055;      // כבידה
    p.vx *= 0.985;      // התנגדות אוויר
    p.vy *= 0.985;
    p.life -= p.decay;

    fxCtx.globalAlpha = Math.max(p.life, 0);
    fxCtx.fillStyle = p.color;
    fxCtx.beginPath();
    fxCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    fxCtx.fill();
  });
  fxCtx.globalAlpha = 1;

  if(now > fxEndAt && fxParticles.length === 0) {
    fxRunning = false;
    fxCanvas.classList.remove('on');
    return;
  }
  requestAnimationFrame(fxLoop);
}

function celebrate(semesterLabel) {
  // כיבוד העדפת מערכת להפחתת אנימציות — מציגים רק את הבאנר
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const banner = document.getElementById('fxBanner');
  document.getElementById('fxTitle').textContent = `סיימת את כל ${semesterLabel}!`;
  document.getElementById('fxSub').textContent = 'כל הכבוד — מגיע לך 🌿';
  banner.classList.add('on');
  setTimeout(() => banner.classList.remove('on'), 4200);

  if(reduce) return;

  fxResize();
  fxCanvas.classList.add('on');
  fxEndAt = performance.now() + 3800;
  fxNextBurst = 0;
  // שלושה פיצוצים מיידיים לפתיחה
  fxBurst(fxCanvas.width * 0.3, fxCanvas.height * 0.35);
  setTimeout(() => fxBurst(fxCanvas.width * 0.7, fxCanvas.height * 0.3), 220);
  setTimeout(() => fxBurst(fxCanvas.width * 0.5, fxCanvas.height * 0.45), 440);

  if(!fxRunning) {
    fxRunning = true;
    requestAnimationFrame(fxLoop);
  }
}

// ── INIT ─────────────────────────────────────────────────────────────────────
loadProgress();
buildTabs();
render();
updateHeroCountdown();
setInterval(updateHeroCountdown, 1000);
</script>

</body>
</html>
